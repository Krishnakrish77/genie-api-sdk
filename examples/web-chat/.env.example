# Copy this file to .env and replace every placeholder. Never commit .env.
WORKATO_API_KEY=replace-with-your-genie-client-api-key
WORKATO_IDP_USER_ID=replace-with-your-workato-idp-user-id
WORKATO_GENIE_HANDLE=replace-with-your-genie-handle

# Optional: only set this for another Workato data center or a test server.
# WORKATO_BASE_URL=https://genie-api.workato.com

# Optional: defaults to 3000.
# PORT=3000

# Required only for the opt-in real-workspace smoke test.
# GENIE_E2E=1
# GENIE_E2E_MESSAGE=Reply with exactly: SDK_E2E_OK
